rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function roleWeight(role) {
      return role == 'admin' ? 2 : (role == 'manager' ? 1 : (role == 'worker' ? 1 : (role == 'viewer' ? 0 : -1)));
    }

    function isAtLeast(minRole) {
      return signedIn() && roleWeight(roleOf(request.auth.uid)) >= roleWeight(minRole);
    }

    function canDelete() {
      return signedIn() && (roleOf(request.auth.uid) == 'manager' || roleOf(request.auth.uid) == 'admin');
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAtLeast('admin'));
      allow create: if signedIn() && (uid == request.auth.uid || isAtLeast('admin'));
      allow update: if signedIn() && (
        (uid == request.auth.uid && request.resource.data.role == resource.data.role) ||
        (isAtLeast('admin') && uid != request.auth.uid)
      );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if isAtLeast('manager');
      allow update: if isAtLeast('manager') && roleOf(request.auth.uid) != 'worker';
      allow delete: if canDelete();
    }

    match /{document=**} {
      allow read: if signedIn();
      allow create, update: if isAtLeast('manager');
      allow delete: if canDelete();
    }
  }
}
